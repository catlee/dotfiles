#!/usr/bin/env bash
exec &> >(tee -a $HOME/.dotfile-install.log)
set -e
set -x

CONFIGS=("install.conf.yaml")

case $(uname) in
Darwin*)
  CONFIGS+=("mac.conf.yaml")
  ;;
Linux*)
  if [[ -d "$HOME/.config/omarchy" ]]; then
    CONFIGS+=("omarchy.conf.yaml")
  else
    CONFIGS+=("linux.conf.yaml")
  fi
  ;;
esac

CONFIGS+=("after.conf.yaml")

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GITCONFIG="${HOME}/.gitconfig"

# Keep machine- and tool-local global Git settings out of the tracked config.
if [[ -L "${GITCONFIG}" && "$(realpath "${GITCONFIG}")" == "${BASEDIR}/gitconfig" ]]; then
  rm "${GITCONFIG}"
fi
if [[ ! -e "${GITCONFIG}" ]]; then
  printf '# Machine-local Git config. Tool-managed global settings stay here.\n[include]\n\tpath = %s/gitconfig\n\tpath = ~/.gitconfig.local\n' "${BASEDIR}" > "${GITCONFIG}"
fi

cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive --depth 1

for CONFIG in "${CONFIGS[@]}"; do
  "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"
done
